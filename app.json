{
  "expo": {
    "name": "Sesli Kitap",
    "slug": "sesli-kitap",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fatihuzunoglu.seslikitap",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fatihuzunoglu.seslikitap"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kitap sayfalarının fotoğraflarını seçip sesli okuyabilmek için fotoğraflarınıza erişim gerekir.",
          "cameraPermission": "Kitap sayfalarını fotoğraflayıp sesli okuyabilmek için kameraya erişim gerekir.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "seslikitap",
    "experiments": {
      "typedRoutes": true
    }
  }
}
